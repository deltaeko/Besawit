{
  "name": "besawit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:platform": "drizzle-kit migrate --config=drizzle.platform.config.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate:platform": "drizzle-kit generate --config=drizzle.platform.config.ts",
    "db:push:platform": "drizzle-kit push --config=drizzle.platform.config.ts",
    "db:studio:platform": "drizzle-kit studio --config=drizzle.platform.config.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker:provision": "tsx scripts/process-provision-jobs.ts",
    "worker:provision:once": "tsx scripts/process-provision-jobs.ts --once",
    "check": "npm run lint && npm run typecheck",
    "test": "tsx --test tests/critical-regressions.test.ts tests/platform-smtp.test.ts tests/trial-ready-email.test.ts tests/smoke/release-readiness-doc.test.ts",
    "test:smoke": "tsx --test tests/smoke/core-api-smoke.test.ts tests/smoke/trial-flow-smoke.test.ts",
    "smoke:core-api": "tsx scripts/smoke-core-api.ts",
    "smoke:trial-flow": "tsx scripts/smoke-trial-flow.ts",
    "verify:release": "npm run check && npm run test && npm run smoke:core-api && npm run smoke:trial-flow"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "marked": "^17.0.5",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
